# Copy thành scripts/.env (đã gitignore, không commit). Dùng bởi scripts/jira_sync.py và
# scripts/confluence_sync.py.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_API_TOKEN=
JIRA_EMAIL=

# Confluence Cloud (scripts/confluence_sync.py) — CÙNG site Atlassian với Jira ở trên thì
# KHÔNG cần điền gì thêm (script tự dùng lại JIRA_BASE_URL/EMAIL/TOKEN, đã xác nhận thật cùng
# 1 token dùng chung được cho cả 2 API). Chỉ điền nếu Confluence nằm ở site/tài khoản khác.
# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
