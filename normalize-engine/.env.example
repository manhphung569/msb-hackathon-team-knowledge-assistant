# Copy thành .env, không commit/chia sẻ file .env thật.
# Chỉ cần khi chạy `normalize ocr` (OCR các PDF scan/ảnh qua OpenAI vision API).
OPENAI_API_KEY=

# GreenNode AI Agent Platform (MSB AI Hackathon 2026 co-organizer) — opt-in cho `normalize ocr`,
# mặc định vẫn dùng OPENAI_API_KEY ở trên. Set OCR_PROVIDER=greennode để chuyển sang GreenNode
# (xem converters/ocr.py) — pending docs/keys tại thời điểm thêm dòng này.
OCR_PROVIDER=
GREENNODE_API_KEY=
GREENNODE_BASE_URL=
