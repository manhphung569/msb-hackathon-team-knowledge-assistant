# Copy thành scripts/.env.mcp-atlassian (đã gitignore, không commit).
#
# Dùng bởi .mcp.json (server "mcp-atlassian", image ghcr.io/sooperset/mcp-atlassian) để cho
# Claude Code tool gọi TRỰC TIẾP/SỐNG tới Jira + Confluence (search rồi mới fetch chi tiết —
# xem docs/decisions/2026-09-21_add-atlassian-mcp-live-search.md) thay vì chỉ đọc bản batch-sync
# cũ trong normalized/_jira-notes, _confluence-docs (scripts/jira_sync.py, confluence_sync.py).
#
# TÊN BIẾN Ở ĐÂY KHÁC scripts/.env (JIRA_BASE_URL/JIRA_EMAIL) — mcp-atlassian dùng đúng tên
# JIRA_URL/JIRA_USERNAME theo docs của chính nó (github.com/sooperset/mcp-atlassian). Điền LẠI
# cùng site/email/token đã dùng cho scripts/.env (site demo msb-ai.atlassian.net, xem
# tenants/demo/README.md), không phải giá trị khác.

JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=
JIRA_API_TOKEN=

CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Read-only: tool chỉ được search/đọc, không tạo/sửa issue hay page qua kết nối này.
READ_ONLY_MODE=true

# Giới hạn đúng phạm vi site demo (tránh agent search lan sang project Atlassian khác nếu site
# có thêm project ngoài TKA).
JIRA_PROJECTS_FILTER=TKA

# CONFLUENCE_SPACES_FILTER=<space-key> — đã xác nhận SỐNG 2026-09-21 (qua confluence_search
# thật): nội dung demo nằm ở 2 space — "SD" (key ngắn) và space cá nhân
# "~712020d8789b70cc11486fb023a92282816d38". Để trống (mặc định) = không lọc, áp dụng toàn site
# — đủ cho cả 2. Chỉ điền nếu muốn giới hạn chặt hơn, vd "SD,~712020d8789b70cc11486fb023a92282816d38".
