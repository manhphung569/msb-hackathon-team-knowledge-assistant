# Vault AI Chat — LLM API Key Configuration
# Copy this file to .env, then uncomment ONE of the following:

# ANTHROPIC_API_KEY=sk-ant-...      # Claude Haiku (recommended — fast, cheap)
# OPENAI_API_KEY=sk-...             # OpenAI gpt-4o-mini
# DASHSCOPE_API_KEY=sk-...          # Qwen qwen-plus (cheapest)
# GITHUB_TOKEN=ghp_...              # GitHub Models (free tier)
# GREENNODE_API_KEY=...             # GreenNode (MSB AI Hackathon 2026 co-organizer) — also
# GREENNODE_BASE_URL=...            # needs BASE_URL; pending docs/keys as of this writing.

# Optional — override default provider/model:
# VAULT_CHAT_PROVIDER=anthropic      # anthropic | openai | qwen | github | greennode
# VAULT_CHAT_MODEL=claude-haiku-4-5-20251001

# graphrag-engine's shared knowledge index (see graphrag_client.py) — required for chat.py's
# discover-mode retrieval, which now calls this instead of keyword-grepping ARTIFACTS_ROOT.
# GRAPHRAG_API_BASE=http://127.0.0.1:8000
# GRAPHRAG_API_KEY=                  # the target tenant's GUEST_API_KEY (graphrag-engine/.env)

# WORKBENCH_DATA_DIR — point at a throwaway directory for any non-production run (hackathon
# demo, local testing). NEVER unset this against a real deployment's data/vault.db copy — see
# "Before touching data/vault.db" in workbench/README.md.
# WORKBENCH_DATA_DIR=

# Optional — Teams bridge (NOT configured in the pdlc-core source environment either;
# the Teams integration code path is present but inert without these):
# VAULT_TEAMS_CLIENT_ID=
# VAULT_TEAMS_CLIENT_SECRET=
# VAULT_TEAMS_TENANT_ID=
# VAULT_TEAMS_REDIRECT_URI=
# VAULT_TEAMS_TOKEN_KEY=

# Content-source roots (default: sibling repos of pdlc-vault — usually correct as-is).
# Content is UNCHANGED by this migration: still reads Discovery/ADLC specs from
# pdlc-artifacts, not from this repo's own tenants/. See migration ADR for why.
# PDLC_ARTIFACTS_ROOT=D:\Projects\repos\pdlc-artifacts
# PDLC_SOURCES_ROOT=D:\Projects\repos\sources

# WORKBENCH_PORT=8766
