# Copy thành .env, không commit/chia sẻ file .env thật.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# GreenNode AI Agent Platform (MSB AI Hackathon 2026 co-organizer, bắt buộc theo luật cuộc thi)
# — pending docs/keys tại thời điểm thêm dòng này. Viết theo giả định OpenAI-compatible
# (embedding/embedder.py GreenNodeEmbedder, generation/answer_generator.py _generate_greennode,
# graph_extraction/_llm_util.py _call_greennode) — cần cả 2 biến dưới để bật provider: greennode
# ở config/settings.yaml.
GREENNODE_API_KEY=
GREENNODE_BASE_URL=
GREENNODE_EMBED_MODEL=

# Chỉ cần khi vector_store.backend: qdrant (config/settings.yaml)
QDRANT_URL=http://localhost:6333

# Chỉ cần khi graph_store.backend: neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Chỉ cần khi dùng model local cho tài liệu confidential
OLLAMA_HOST=http://localhost:11434

# Chỉ cần khi chạy `graphrag serve` (API cho người khác truy vấn, xem README mục API) —
# tự sinh 1 chuỗi ngẫu nhiên dài, đưa cho đúng người cần, không dùng chung với bất kỳ key nào khác.
GUEST_API_KEY=

# BÍ MẬT TUYỆT ĐỐI — key này có quyền GHI (endpoint /capture, /folders — dùng cho extension
# thu thập tri thức, xem README mục Capture). Không đưa cho ai, không dùng chung với
# GUEST_API_KEY (key đó chỉ đọc, an toàn để chia sẻ).
OWNER_API_KEY=
